+    }
+    let anchor = electromagnetic_eos(anchor_temperature_mev)
+        .map_err(|_| "electromagnetic reconstruction EOS failed")?;
+    if target_rho_mev4.to_bits() == anchor.rho.to_bits() {
+        return Ok(anchor_temperature_mev);
+    }
