\newlabel{fig:channels}{{12}{36}{Channel decomposition. Panel~(a) separates the expansion-driven and distribution-driven contributions to $\Delta \Yp $; panel~(b) shows their fractions as a function of $\Sigma _H$. The figure is intended as a decomposition diagnostic for the production path rather than as an additional independent constraint figure}{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces BBN yields vs $\Sigma _H$ (CL2, characteristic transport, $\eta = 6.104 \times 10^{-10}$, $\tau _n = 878.4\,\mathrm  {s}$).}}{36}{table.caption.17}\protected@file@percent }
\newlabel{tab:yields}{{3}{36}{BBN yields vs $\Sigma _H$ (CL2, characteristic transport, $\eta = 6.104 \times 10^{-10}$, $\tau _n = 878.4\,\mathrm {s}$)}{table.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.2}Direct BBN yield response}{36}{subsection.17.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Bridge from the augmented monopole to the weak rates. (a) The characteristic solution produces a weak-rate-relevant monopole $\tilde  f_0(q)$ that is harder than the FLRW Fermi--Dirac reference. (b) The relative augmentation grows toward the high-$q$ rate-support domain. (c) The resulting perturbation induces a finite weak-rate response on the resolved early-time domain relevant for freeze-out. (d) Integrating over momentum shows a cumulative fractional shift in $\lambda _{n\to p}$ and $\lambda _{p\to n}$ at the representative epoch $T_\gamma \simeq 0.80$ MeV. Together these panels exhibit the middle link between characteristic transport and the final BBN-yield shift.}}{37}{figure.caption.16}\protected@file@percent }
\newlabel{fig:story_bridge}{{13}{37}{Bridge from the augmented monopole to the weak rates. (a) The characteristic solution produces a weak-rate-relevant monopole $\tilde f_0(q)$ that is harder than the FLRW Fermi--Dirac reference. (b) The relative augmentation grows toward the high-$q$ rate-support domain. (c) The resulting perturbation induces a finite weak-rate response on the resolved early-time domain relevant for freeze-out. (d) Integrating over momentum shows a cumulative fractional shift in $\lambda _{n\to p}$ and $\lambda _{p\to n}$ at the representative epoch $T_\gamma \simeq 0.80$ MeV. Together these panels exhibit the middle link between characteristic transport and the final BBN-yield shift}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.3}Constraint from the profile likelihood}{37}{subsection.17.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Direct BBN observable response to anisotropic expansion. The panels show the CL2 production predictions for $Y_p$ and D/H as functions of the initial anisotropy parameter $\Sigma _H$, together with the adopted observational bands and the FLRW reference. The dashed vertical line marks the exploratory caution boundary of the current SciPy reference path. This figure closes the physics chain established by the geometry and bridge figures: the modified transport and weak chemistry are converted into the final observable shifts on which the likelihood constraint is built.}}{38}{figure.caption.18}\protected@file@percent }
\newlabel{fig:observable_response}{{14}{38}{Direct BBN observable response to anisotropic expansion. The panels show the CL2 production predictions for $Y_p$ and D/H as functions of the initial anisotropy parameter $\Sigma _H$, together with the adopted observational bands and the FLRW reference. The dashed vertical line marks the exploratory caution boundary of the current SciPy reference path. This figure closes the physics chain established by the geometry and bridge figures: the modified transport and weak chemistry are converted into the final observable shifts on which the likelihood constraint is built}{figure.caption.18}{}}
