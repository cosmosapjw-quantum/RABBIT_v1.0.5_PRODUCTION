+def test_invalid_nonfinal_stored_state_fails_before_postprocessing(monkeypatch):
+    """Catches validation of only the final accepted state after solver success."""
+
+    def fake_solve(_fun, t_span, y0, **_kwargs):
+        return _fake_success(t_span, y0, mutate=lambda states: states.__setitem__((0, 0), -1e-9))
+
+    monkeypatch.setattr(driver, "solve_ivp", fake_solve)
+    with pytest.raises(RuntimeError) as caught:
+        integrate_flrw_decoupling(n_q=8, collisions=False)
+
+    assert type(caught.value).__name__ == "RawStateAdmissionError"
+    assert caught.value.reason == "occupation_outside_strict_open_interval"
+    assert caught.value.sample_index == 0
+
+
+@pytest.mark.parametrize(
+    ("row", "value", "reason"),
+    [
+        (0, 0.0, "occupation_outside_strict_open_interval"),
+        (0, 1.0, "occupation_outside_strict_open_interval"),
+        (0, -1e-9, "occupation_outside_strict_open_interval"),
+        (0, 1.0 + 1e-9, "occupation_outside_strict_open_interval"),
+        (0, np.nan, "occupation_outside_strict_open_interval"),
+        (0, np.inf, "occupation_outside_strict_open_interval"),
+        (-1, 0.0, "nonfinite_time_or_nonpositive_temperature"),
+        (-1, -1.0, "nonfinite_time_or_nonpositive_temperature"),
+        (-1, np.nan, "nonfinite_time_or_nonpositive_temperature"),
+        (-1, np.inf, "nonfinite_time_or_nonpositive_temperature"),
+    ],
+)
+def test_invalid_final_stored_state_never_reaches_observables(monkeypatch, row, value, reason):
+    """Catches final-state clipping/flooring before moment and observable calculation."""
+
+    original_moment = driver.spectral_energy_moment
+    moment_calls = []
+
+    def moment_spy(*args):
+        moment_calls.append(1)
+        return original_moment(*args)
+
+    def fake_solve(_fun, t_span, y0, **_kwargs):
+        result = _fake_success(
+            t_span, y0, mutate=lambda states: states.__setitem__((row, -1), value)
+        )
+        result.t, result.y = result.t[-1:], result.y[:, -1:]
+        return result
+
+    monkeypatch.setattr(driver, "spectral_energy_moment", moment_spy)
+    monkeypatch.setattr(driver, "solve_ivp", fake_solve)
+    with pytest.raises(RuntimeError) as caught:
+        integrate_flrw_decoupling(n_q=8, collisions=False)
+
+    assert type(caught.value).__name__ == "RawStateAdmissionError"
+    assert caught.value.reason == reason
+    assert caught.value.sample_index == 0
+    assert moment_calls == []
+
+
+def test_exactly_one_terminal_event_is_required(monkeypatch):
+    """Catches accepting an ambiguous result containing duplicate terminal events."""
+
+    def fake_solve(_fun, t_span, y0, **_kwargs):
+        result = _fake_success(t_span, y0)
+        result.t_events = [np.array([result.t[-1], result.t[-1]])]
+        return result
+
+    monkeypatch.setattr(driver, "solve_ivp", fake_solve)
+    with pytest.raises(RuntimeError, match="exactly one endpoint event"):
+        integrate_flrw_decoupling(n_q=8, collisions=False)
+
+
+@pytest.mark.parametrize("H", [0.0, -1.0, np.nan, np.inf])
+def test_stored_state_requires_finite_positive_hubble(monkeypatch, H):
+    """Catches trusting an unevaluated or floored Hubble rate after solve success."""
+
+    monkeypatch.setattr(driver, "solve_ivp", lambda _f, span, y0, **_kw: _fake_success(span, y0))
+    monkeypatch.setattr(driver, "hubble_3T", lambda *_args: H)
+    with pytest.raises(RuntimeError) as caught:
+        integrate_flrw_decoupling(n_q=8, collisions=False)
+
+    assert type(caught.value).__name__ == "RawStateAdmissionError"
+    assert caught.value.reason == "nonfinite_or_nonpositive_hubble"
+
+
+def test_rhs_rejects_nonpositive_hubble_before_collision_work(monkeypatch):
+    """Catches flooring H=0 and dividing collision work by an artificial 1e-100."""
+
+    monkeypatch.setattr(driver, "hubble_3T", lambda *_args: 0.0)
+    collision_calls = []
+
+    def fake_collision(field, *_args):
+        collision_calls.append(1)
+        return np.zeros_like(field)
+
+    monkeypatch.setattr(driver, "_collision_field", fake_collision)
+    rhs, Y, *_ = _make_rhs(_quad(8), collisions=True)
+    state = np.concatenate([1.0 / (np.exp(Y) + 1.0)] * 2 + [[2.0]])
+
+    with pytest.raises(RuntimeError) as caught:
+        rhs(0.0, state)
+
+    assert type(caught.value).__name__ == "RawStateAdmissionError"
+    assert caught.value.reason == "nonfinite_or_nonpositive_hubble"
+    assert collision_calls == []
+
+
+def test_rhs_probe_clamp_does_not_reject_valid_stored_trajectory(monkeypatch):
+    """Catches conflating an out-of-domain Radau probe with an accepted sample."""
+
+    captured = {}
+
+    def fake_solve(fun, t_span, y0, **_kwargs):
+        probe = y0.copy()
+        probe[0], probe[1] = -0.25, 1.25
+        assert np.all(np.isfinite(fun(t_span[0], probe)))
+        captured["final"] = y0.copy()
+        return _fake_success(t_span, y0)
+
+    monkeypatch.setattr(driver, "solve_ivp", fake_solve)
+    result = integrate_flrw_decoupling(n_q=8, collisions=False)
+    n = captured["final"].size // 2
+
+    np.testing.assert_array_equal(result.f_nue_final, captured["final"][:n])
+    np.testing.assert_array_equal(result.f_nux_final, captured["final"][n : 2 * n])
+    assert result.max_clip_excursion == 0.0
