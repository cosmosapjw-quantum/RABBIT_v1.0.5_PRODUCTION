    def test_log_posterior_with_prior(self):
        """Prior contributes to log-posterior."""
        def rhs_factory(params):
            def rhs(t, y):
                return -params[0] * y
            return rhs
    
        # Gaussian prior on λ: mean=1, std=0.5
        def prior_fn(params):
            return -0.5 * ((params[0] - 1.0) / 0.5) ** 2
    
